<div class="h-full w-full max-w-3xl mx-auto flex flex-col bg-gray-50 drop-shadow text-gray-700">
  <ol class="grow flex flex-col-reverse overflow-y-auto p-4 space-y-reverse space-y-4">
    <li
      :for={message <- @messages}
      class="flex space-x-4 border-b first:border-b-0 hover:bg-gray-200 transition-colors p-4 rounded-lg"
    >
      <div class="shrink-0 pt-0.5 opacity-75">
        <div class="shrink-0 pt-0.5 opacity-75">
          <%= cond do %>
            <% message["role"] == "user" -> %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
              </svg>
            <% message["role"] == "tool" -> %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
              </svg>
            <% true -> %>
              <.icon name="hero-cpu-chip" class="w-6 h-6" />
          <% end %>
        </div>
      </div>
      <div class="leading-7 w-full">
        <%= cond do %>
          <% Map.has_key?(message, "tool_calls") -> %>
            <div class="mb-2">
              <Unsafe.raw_markdown content={message["content"]} />
            </div>
            <div
              :for={tool_call <- message["tool_calls"]}
              class="bg-gray-100 p-3 rounded border border-gray-300 mb-2"
            >
              <div class="font-semibold text-blue-700">
                Using tool: {tool_call["function"]["name"]}
              </div>
              <pre class="text-xs overflow-x-auto p-2 bg-gray-50 rounded mt-1"><%= tool_call["function"]["arguments"] %></pre>
            </div>
          <% message["role"] == "tool" -> %>
            <div class="bg-green-50 p-3 rounded border border-green-200">
              <div class="font-semibold text-green-700">Tool Result</div>
              <pre class="text-xs overflow-x-auto p-2 bg-white rounded mt-1"><%= message["content"] %></pre>
            </div>
          <% true -> %>
            <Unsafe.raw_markdown content={message["content"]} />
        <% end %>
      </div>
    </li>
    <li class="h-full hidden only:flex items-center justify-center">
      No messages. Enter a message below to begin.
    </li>
  </ol>

  <div class="shrink-0 w-full">
    <form class="border-t border-gray-200 p-4 space-y-2" phx-submit="submit">
      <textarea
        name="content"
        class="block w-full resize-none rounded bg-white
               border-gray-200 focus:border-gray-300
               focus:ring-0 focus:shadow-sm"
        placeholder="Enter a message..."
        rows={4}
      ></textarea>

      <div class="flex justify-end space-x-2">
        <%= if @running do %>
          <button
            type="button"
            phx-click="stop"
            class="flex items-center justify-center
                   px-3 py-1.5 rounded
                   bg-red-200 hover:bg-red-300
                   transition"
          >
            Stop
          </button>
        <% end %>
        <button
          type="submit"
          disabled={@running}
          class="flex items-center justify-center
                 px-3 py-1.5 rounded
                 bg-gray-200 hover:bg-gray-300
                 transition"
        >
          Send
        </button>
      </div>
    </form>
  </div>
</div>
